<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jslhrd.yorimichi.mapper.RoadMapper">

    <insert id="insert" parameterType="RoadDTO">
        INSERT INTO road (sigungu_id, name)
        VALUES (#{sigunguId}, #{name})
    </insert>

    <select id="selectById" parameterType="long" resultType="RoadDTO">
        SELECT * FROM road WHERE id = #{id}
    </select>

    <select id="selectBySigunguId" parameterType="long" resultType="RoadDTO">
        SELECT * FROM road WHERE sigungu_id = #{sigunguId} ORDER BY name ASC
    </select>

    <update id="update" parameterType="RoadDTO">
        UPDATE road
        SET name = #{name}, updated_at = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="long">
        DELETE FROM road WHERE id = #{id}
    </delete>

    <delete id="deleteBySigunguId" parameterType="long">
        DELETE FROM road WHERE sigungu_id = #{sigunguId}
    </delete>

</mapper>
