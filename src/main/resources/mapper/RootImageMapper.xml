<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jslhrd.yorimichi.mapper.RootImageMapper">

    <insert id="insert" parameterType="RootImageDTO">
        INSERT INTO root_image (root_id, url, alt_text)
        VALUES (#{rootId}, #{url}, #{altText})
    </insert>

    <select id="selectById" parameterType="long" resultType="RootImageDTO">
        SELECT * FROM root_image WHERE id = #{id}
    </select>

    <select id="selectByRootId" parameterType="long" resultType="RootImageDTO">
        SELECT * FROM root_image WHERE root_id = #{rootId}
    </select>

    <delete id="deleteById" parameterType="long">
        DELETE FROM root_image WHERE id = #{id}
    </delete>

    <delete id="deleteByRootId" parameterType="long">
        DELETE FROM root_image WHERE root_id = #{rootId}
    </delete>

</mapper>
