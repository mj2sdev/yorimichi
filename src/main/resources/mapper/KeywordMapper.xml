<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jslhrd.yorimichi.mapper.KeywordMapper">

    <insert id="insert" parameterType="KeywordDTO">
        INSERT INTO keyword (name)
        VALUES (#{name})
    </insert>

    <select id="selectById" parameterType="long" resultType="KeywordDTO">
        SELECT * FROM keyword WHERE id = #{id}
    </select>

    <select id="selectByNameLike" parameterType="string" resultType="KeywordDTO">
        SELECT * FROM keyword WHERE name LIKE CONCAT('%', #{name}, '%') ORDER BY name ASC
    </select>

    <update id="update" parameterType="KeywordDTO">
        UPDATE keyword
        SET name = #{name}, updated_at = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="long">
        DELETE FROM keyword WHERE id = #{id}
    </delete>

</mapper>
