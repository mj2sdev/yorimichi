<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jslhrd.yorimichi.mapper.KeywordMapper">

    <!-- @formatter:off -->

    <select id="selectAll" resultType="KeywordDTO">
        SELECT id,
               name,
               created_at,
               updated_at
        FROM keyword
        ORDER BY name, id DESC
    </select>

    <select id="selectById" parameterType="long" resultType="KeywordDTO">
        SELECT id,
               name,
               created_at,
               updated_at
        FROM keyword
        WHERE id = #{keywordId}
    </select>

    <select id="existsById" parameterType="long" resultType="boolean">
        SELECT EXISTS (
            SELECT 1
            FROM keyword
            WHERE id = #{keywordId}
        )
    </select>

    <insert id="insert"
            parameterType="KeywordDTO"
            useGeneratedKeys="true"
            keyProperty="id"
            keyColumn="id">
        INSERT INTO keyword (name)
        VALUES (#{name})
    </insert>

    <update id="update">
        UPDATE keyword
        SET name = #{keyword.name}
        WHERE id = #{keywordId}
    </update>

    <delete id="deleteById" parameterType="long">
        DELETE
        FROM keyword
        WHERE id = #{keywordId}
    </delete>

    <!-- @formatter:on -->

</mapper>