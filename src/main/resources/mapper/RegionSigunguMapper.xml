<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jslhrd.yorimichi.mapper.RegionSigunguMapper">

    <insert id="insert" parameterType="RegionSigunguDTO">
        INSERT INTO region_sigungu (sido_id, name)
        VALUES (#{sidoId}, #{name})
    </insert>

    <select id="selectById" parameterType="long" resultType="RegionSigunguDTO">
        SELECT * FROM region_sigungu WHERE id = #{id}
    </select>

    <select id="selectBySidoId" parameterType="long" resultType="RegionSigunguDTO">
        SELECT * FROM region_sigungu WHERE sido_id = #{sidoId} ORDER BY name ASC
    </select>

    <update id="update" parameterType="RegionSigunguDTO">
        UPDATE region_sigungu
        SET name = #{name}, updated_at = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="long">
        DELETE FROM region_sigungu WHERE id = #{id}
    </delete>

    <delete id="deleteBySidoId" parameterType="long">
        DELETE FROM region_sigungu WHERE sido_id = #{sidoId}
    </delete>

</mapper>
