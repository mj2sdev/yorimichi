<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jslhrd.yorimichi.mapper.FoodCategoryMapper">

    <insert id="insert" parameterType="FoodCategoryDTO">
        INSERT INTO food_category (food_id, category_id)
        VALUES (#{foodId}, #{categoryId})
    </insert>

    <select id="selectById" parameterType="long" resultType="FoodCategoryDTO">
        SELECT * FROM food_category WHERE id = #{id}
    </select>

    <select id="selectByFoodId" parameterType="long" resultType="FoodCategoryDTO">
        SELECT * FROM food_category WHERE food_id = #{foodId}
    </select>

    <select id="selectByCategoryId" parameterType="long" resultType="FoodCategoryDTO">
        SELECT * FROM food_category WHERE category_id = #{categoryId}
    </select>

    <delete id="deleteById" parameterType="long">
        DELETE FROM food_category WHERE id = #{id}
    </delete>

    <delete id="deleteByFoodId" parameterType="long">
        DELETE FROM food_category WHERE food_id = #{foodId}
    </delete>

    <delete id="deleteByCategoryId" parameterType="long">
        DELETE FROM food_category WHERE category_id = #{categoryId}
    </delete>

</mapper>
