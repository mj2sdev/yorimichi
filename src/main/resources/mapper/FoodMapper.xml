<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jslhrd.yorimichi.mapper.FoodMapper">

    <insert id="insert" parameterType="FoodDTO">
        INSERT INTO food (store_id, name, price, description)
        VALUES (#{storeId}, #{name}, #{price}, #{description})
    </insert>

    <select id="selectById" parameterType="long" resultType="FoodDTO">
        SELECT * FROM food WHERE id = #{id}
    </select>

    <select id="selectByStoreId" parameterType="long" resultType="FoodDTO">
        SELECT * FROM food WHERE store_id = #{storeId}
    </select>

    <select id="selectPaged" resultType="FoodDTO">
        SELECT * FROM food ORDER BY created_at DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <update id="update" parameterType="FoodDTO">
        UPDATE food
        SET name = #{name}, price = #{price}, description = #{description}, updated_at = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="long">
        DELETE FROM food WHERE id = #{id}
    </delete>

    <delete id="deleteByStoreId" parameterType="long">
        DELETE FROM food WHERE store_id = #{storeId}
    </delete>

</mapper>
