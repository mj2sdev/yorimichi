<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jslhrd.yorimichi.mapper.RegionEmdMapper">

    <insert id="insert" parameterType="RegionEmdDTO">
        INSERT INTO region_emd (sigungu_id, name)
        VALUES (#{sigunguId}, #{name})
    </insert>

    <select id="selectById" parameterType="long" resultType="RegionEmdDTO">
        SELECT * FROM region_emd WHERE id = #{id}
    </select>

    <select id="selectBySigunguId" parameterType="long" resultType="RegionEmdDTO">
        SELECT * FROM region_emd WHERE sigungu_id = #{sigunguId} ORDER BY name ASC
    </select>

    <update id="update" parameterType="RegionEmdDTO">
        UPDATE region_emd
        SET name = #{name}, updated_at = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="long">
        DELETE FROM region_emd WHERE id = #{id}
    </delete>

    <delete id="deleteBySigunguId" parameterType="long">
        DELETE FROM region_emd WHERE sigungu_id = #{sigunguId}
    </delete>

</mapper>
