<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jslhrd.yorimichi.mapper.ReviewMapper">

    <insert id="insert" parameterType="ReviewDTO">
        INSERT INTO review (store_id, user_id, rating, content)
        VALUES (#{storeId}, #{userId}, #{rating}, #{content})
    </insert>

    <select id="selectById" parameterType="long" resultType="ReviewDTO">
        SELECT * FROM review WHERE id = #{id}
    </select>

    <select id="selectByStoreId" parameterType="long" resultType="ReviewDTO">
        SELECT * FROM review WHERE store_id = #{storeId} ORDER BY created_at DESC
    </select>

    <select id="selectByUserId" parameterType="long" resultType="ReviewDTO">
        SELECT * FROM review WHERE user_id = #{userId} ORDER BY created_at DESC
    </select>

    <update id="update" parameterType="ReviewDTO">
        UPDATE review
        SET rating = #{rating}, content = #{content}, updated_at = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="long">
        DELETE FROM review WHERE id = #{id}
    </delete>

    <delete id="deleteByStoreId" parameterType="long">
        DELETE FROM review WHERE store_id = #{storeId}
    </delete>

    <delete id="deleteByUserId" parameterType="long">
        DELETE FROM review WHERE user_id = #{userId}
    </delete>

</mapper>
