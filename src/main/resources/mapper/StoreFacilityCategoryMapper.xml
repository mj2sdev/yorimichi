<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jslhrd.yorimichi.mapper.StoreFacilityCategoryMapper">

    <insert id="insert" parameterType="StoreFacilityCategoryDTO">
        INSERT INTO store_facility_category (store_id, category_id)
        VALUES (#{storeId}, #{categoryId})
    </insert>

    <select id="selectById" parameterType="long" resultType="StoreFacilityCategoryDTO">
        SELECT * FROM store_facility_category WHERE id = #{id}
    </select>

    <select id="selectByStoreId" parameterType="long" resultType="StoreFacilityCategoryDTO">
        SELECT * FROM store_facility_category WHERE store_id = #{storeId}
    </select>

    <select id="selectByCategoryId" parameterType="long" resultType="StoreFacilityCategoryDTO">
        SELECT * FROM store_facility_category WHERE category_id = #{categoryId}
    </select>

    <delete id="deleteById" parameterType="long">
        DELETE FROM store_facility_category WHERE id = #{id}
    </delete>

    <delete id="deleteByStoreId" parameterType="long">
        DELETE FROM store_facility_category WHERE store_id = #{storeId}
    </delete>

    <delete id="deleteByCategoryId" parameterType="long">
        DELETE FROM store_facility_category WHERE category_id = #{categoryId}
    </delete>

</mapper>
