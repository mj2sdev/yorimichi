<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jslhrd.yorimichi.mapper.FeedCoeatMapper">

    <insert id="insert" parameterType="FeedCoeatDTO">
        INSERT INTO feed_coeat (feed_id, host_user_id, title, description, status)
        VALUES (#{feedId}, #{hostUserId}, #{title}, #{description}, #{status})
    </insert>

    <select id="selectById" parameterType="long" resultType="FeedCoeatDTO">
        SELECT * FROM feed_coeat WHERE id = #{id}
    </select>

    <select id="selectByFeedId" parameterType="long" resultType="FeedCoeatDTO">
        SELECT * FROM feed_coeat WHERE feed_id = #{feedId}
    </select>

    <select id="selectByHostUserId" parameterType="long" resultType="FeedCoeatDTO">
        SELECT * FROM feed_coeat WHERE host_user_id = #{userId}
    </select>

    <select id="selectPaged" resultType="FeedCoeatDTO">
        SELECT * FROM feed_coeat ORDER BY created_at DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <update id="update" parameterType="FeedCoeatDTO">
        UPDATE feed_coeat
        SET title = #{title}, description = #{description}, status = #{status}, updated_at = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="long">
        DELETE FROM feed_coeat WHERE id = #{id}
    </delete>

    <delete id="deleteByFeedId" parameterType="long">
        DELETE FROM feed_coeat WHERE feed_id = #{feedId}
    </delete>

</mapper>
