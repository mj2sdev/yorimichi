<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jslhrd.yorimichi.mapper.RegionSidoMapper">

    <insert id="insert" parameterType="RegionSidoDTO">
        INSERT INTO region_sido (code, name)
        VALUES (#{code}, #{name})
    </insert>

    <select id="selectById" parameterType="Long" resultType="RegionSidoDTO">
        SELECT id, code, name, created_at, updated_at
        FROM region_sido
        WHERE id = #{id}
    </select>

    <update id="update" parameterType="RegionSidoDTO">
        UPDATE region_sido
        SET code = #{code}, name = #{name}
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="Long">
        DELETE FROM region_sido WHERE id = #{id}
    </delete>

</mapper>