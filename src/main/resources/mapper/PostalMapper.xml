<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jslhrd.yorimichi.mapper.PostalMapper">

    <insert id="insert" parameterType="PostalDTO">
        INSERT INTO postal (emd_id, code, address)
        VALUES (#{emdId}, #{code}, #{address})
    </insert>

    <select id="selectById" parameterType="long" resultType="PostalDTO">
        SELECT * FROM postal WHERE id = #{id}
    </select>

    <select id="selectByCode" parameterType="string" resultType="PostalDTO">
        SELECT * FROM postal WHERE code = #{code}
    </select>

    <select id="selectByRegionEmdId" parameterType="long" resultType="PostalDTO">
        SELECT * FROM postal WHERE emd_id = #{emdId}
    </select>

    <update id="update" parameterType="PostalDTO">
        UPDATE postal
        SET code = #{code}, address = #{address}, updated_at = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="long">
        DELETE FROM postal WHERE id = #{id}
    </delete>

    <delete id="deleteByRegionEmdId" parameterType="long">
        DELETE FROM postal WHERE emd_id = #{emdId}
    </delete>

</mapper>
