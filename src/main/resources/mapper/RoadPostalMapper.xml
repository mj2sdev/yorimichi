<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jslhrd.yorimichi.mapper.RoadPostalMapper">

    <insert id="insert" parameterType="RoadPostalDTO">
        INSERT INTO road_postal (road_id, postal_id)
        VALUES (#{roadId}, #{postalId})
    </insert>

    <select id="selectById" parameterType="long" resultType="RoadPostalDTO">
        SELECT * FROM road_postal WHERE id = #{id}
    </select>

    <select id="selectByRoadId" parameterType="long" resultType="RoadPostalDTO">
        SELECT * FROM road_postal WHERE road_id = #{roadId}
    </select>

    <select id="selectByPostalId" parameterType="long" resultType="RoadPostalDTO">
        SELECT * FROM road_postal WHERE postal_id = #{postalId}
    </select>

    <delete id="deleteById" parameterType="long">
        DELETE FROM road_postal WHERE id = #{id}
    </delete>

    <delete id="deleteByRoadId" parameterType="long">
        DELETE FROM road_postal WHERE road_id = #{roadId}
    </delete>

    <delete id="deleteByPostalId" parameterType="long">
        DELETE FROM road_postal WHERE postal_id = #{postalId}
    </delete>

</mapper>
