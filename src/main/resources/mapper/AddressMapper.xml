<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jslhrd.yorimichi.mapper.AddressMapper">

    <insert id="insert" parameterType="AddressDTO">
        INSERT INTO address (user_id, road, detail, zipcode, is_default)
        VALUES (#{userId}, #{road}, #{detail}, #{zipcode}, #{isDefault})
    </insert>

    <select id="selectById" parameterType="long" resultType="AddressDTO">
        SELECT * FROM address WHERE id = #{id}
    </select>

    <select id="selectByUserId" parameterType="long" resultType="AddressDTO">
        SELECT * FROM address WHERE user_id = #{userId}
    </select>

    <select id="selectDefaultByUserId" parameterType="long" resultType="AddressDTO">
        SELECT * FROM address WHERE user_id = #{userId} AND is_default = 1
    </select>

    <update id="update" parameterType="AddressDTO">
        UPDATE address
        SET road = #{road}, detail = #{detail}, zipcode = #{zipcode}, is_default = #{isDefault}, updated_at = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="long">
        DELETE FROM address WHERE id = #{id}
    </delete>

    <delete id="deleteByUserId" parameterType="long">
        DELETE FROM address WHERE user_id = #{userId}
    </delete>

</mapper>
