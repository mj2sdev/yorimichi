<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jslhrd.yorimichi.mapper.RootKeywordMapper">

    <insert id="insert" parameterType="RootKeywordDTO">
        INSERT INTO root_keyword (root_id, keyword_id)
        VALUES (#{rootId}, #{keywordId})
    </insert>

    <select id="selectById" parameterType="long" resultType="RootKeywordDTO">
        SELECT * FROM root_keyword WHERE id = #{id}
    </select>

    <select id="selectByRootId" parameterType="long" resultType="RootKeywordDTO">
        SELECT * FROM root_keyword WHERE root_id = #{rootId}
    </select>

    <select id="selectByKeywordId" parameterType="long" resultType="RootKeywordDTO">
        SELECT * FROM root_keyword WHERE keyword_id = #{keywordId}
    </select>

    <delete id="deleteById" parameterType="long">
        DELETE FROM root_keyword WHERE id = #{id}
    </delete>

    <delete id="deleteByRootId" parameterType="long">
        DELETE FROM root_keyword WHERE root_id = #{rootId}
    </delete>

    <delete id="deleteByKeywordId" parameterType="long">
        DELETE FROM root_keyword WHERE keyword_id = #{keywordId}
    </delete>

</mapper>
