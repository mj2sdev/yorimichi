<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jslhrd.yorimichi.mapper.FacilityCategoryMapper">

    <insert id="insert" parameterType="FacilityCategoryDTO">
        INSERT INTO facility_category (facility_id, category_id)
        VALUES (#{facilityId}, #{categoryId})
    </insert>

    <select id="selectById" parameterType="long" resultType="FacilityCategoryDTO">
        SELECT * FROM facility_category WHERE id = #{id}
    </select>

    <select id="selectByFacilityId" parameterType="long" resultType="FacilityCategoryDTO">
        SELECT * FROM facility_category WHERE facility_id = #{facilityId}
    </select>

    <select id="selectByCategoryId" parameterType="long" resultType="FacilityCategoryDTO">
        SELECT * FROM facility_category WHERE category_id = #{categoryId}
    </select>

    <delete id="deleteById" parameterType="long">
        DELETE FROM facility_category WHERE id = #{id}
    </delete>

    <delete id="deleteByFacilityId" parameterType="long">
        DELETE FROM facility_category WHERE facility_id = #{facilityId}
    </delete>

    <delete id="deleteByCategoryId" parameterType="long">
        DELETE FROM facility_category WHERE category_id = #{categoryId}
    </delete>

</mapper>
