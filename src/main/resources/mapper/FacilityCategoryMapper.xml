<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jslhrd.yorimichi.mapper.FacilityCategoryMapper">

    <insert id="insert" parameterType="FacilityCategoryDTO">
        INSERT INTO facility_category (name)
        VALUES (#{name})
    </insert>

    <select id="selectById" parameterType="Long" resultType="FacilityCategoryDTO">
        SELECT id, name, created_at, updated_at
        FROM facility_category
        WHERE id = #{id}
    </select>

    <update id="update" parameterType="FacilityCategoryDTO">
        UPDATE facility_category
        SET name = #{name}
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="Long">
        DELETE FROM facility_category WHERE id = #{id}
    </delete>

</mapper>