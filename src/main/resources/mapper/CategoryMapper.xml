<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jslhrd.yorimichi.mapper.CategoryMapper">

    <insert id="insert" parameterType="CategoryDTO">
        INSERT INTO category (parent_id, name)
        VALUES (#{parentId}, #{name})
    </insert>

    <select id="selectById" parameterType="Long" resultType="CategoryDTO">
        SELECT id, parent_id, name, created_at, updated_at
        FROM category
        WHERE id = #{id}
    </select>

    <update id="update" parameterType="CategoryDTO">
        UPDATE category
        SET parent_id = #{parentId},
            name      = #{name}
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="Long">
        DELETE
        FROM category
        WHERE id = #{id}
    </delete>

</mapper>