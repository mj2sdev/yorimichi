<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jslhrd.yorimichi.mapper.FacilityCategoryMapper">

    <!-- @formatter:off -->

    <select id="selectAll" resultType="FacilityCategoryDTO">
        SELECT id,
               name,
               created_at,
               updated_at
        FROM facility_category
        ORDER BY name, id DESC;
    </select>

    <select id="selectById" parameterType="long" resultType="FacilityCategoryDTO">
        SELECT id,
               name,
               created_at,
               updated_at
        FROM facility_category
        WHERE id = #{facilityId}
    </select>

    <select id="selectIdByName" parameterType="string" resultType="long">
        SELECT
            id
        FROM facility_category

        WHERE name = #{name}
    </select>

    <select id="existsById" parameterType="long" resultType="boolean">
        SELECT EXISTS (
            SELECT 1
            FROM facility_category
            WHERE id = #{facilityId})
    </select>

    <insert id="insert"
            parameterType="FacilityCategoryDTO"
            useGeneratedKeys="true"
            keyProperty="id"
            keyColumn="id">
        INSERT INTO facility_category (name)
        VALUES (#{name})
    </insert>

    <update id="update">
        UPDATE facility_category
        SET name = #{facility.name}
        WHERE id = #{facilityId}
    </update>

    <delete id="deleteById" parameterType="long">
        DELETE
        FROM facility_category
        WHERE id = #{facilityId}
    </delete>

    <!-- @formatter:on -->

</mapper>