<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jslhrd.yorimichi.mapper.UserMapper">

    <!-- @formatter:off -->

    <select id="selectAll" parameterType="SearchDTO" resultType="UserDTO">
        SELECT u.id,
               u.role_id,
               u.email,
               u.password,
               u.nickname,
               u.description,
               u.last_login_at,
               r.created_at,
               r.updated_at
        FROM user u
        JOIN root r ON u.id = r.id
            AND r.type = 'USER'
            AND <include refid="com.jslhrd.yorimichi.mapper.common.RootVisible"/>
        ORDER BY r.created_at DESC, u.id
    </select>

    <!--오늘은 내가 resultMap 요리사-->
    <resultMap id="userResultMap" type="UserDTO">
        <id property="id" column=""></id>
        <result property="role" column=""></result>
        <result property="email" column=""></result>
        <result property="nickname" column=""></result>
        <result property="description" column=""></result>
        <result property="gender" column=""></result>
        <result property="year" column=""></result>
        <result property="showReviews" column=""></result>
        <result property="showLikes" column=""></result>
        <result property="showBookmarks" column=""></result>
        <result property="showFollowees" column=""></result>
        <result property="showFollowers" column=""></result>
        <!--TODO: RevieMapper에 userId를 기준으로 검색하는 select문을 만들어야함.-->
        <collection property="reviews" ofType="ReviewDTO" select="com.jslhrd.yorimichi.mapper.ReviewMapper." column="id"></collection>
        <collection property="followees" ofType="UserDTO" select="com.jslhrd.yorimichi.mapper.FollowMapper.selectFolloweesByUserId" column="id"></collection>
        <collection property="followers" ofType="UserDTO" select="com.jslhrd.yorimichi.mapper.FollowMapper.selectFollowersByUserId" column="id"></collection>
        <collection property="blocks" ofType="BlockDTO" select="com.jslhrd.yorimichi.mapper.BlockMapper.selectAllByUserId" column="id"></collection>
        <collection property="bookmarks" ofType="StoreDTO" select="com.jslhrd.yorimichi.mapper.BookmarkMapper.selectByUserId" column="id"></collection>
        <!--TODO: LikeMapper에 userId를 기준으로 검색하는 select문을 만들어야함. -->
        <collection property="likes" ofType="StoreDTO" select="com.jslhrd.yorimichi.mapper.LikeMapper." column="id"></collection>
        
    </resultMap>

    <select id="selectById" resultMap="userResultMap" parameterType="Long">
        SELECT u.id,
               u.role_id,
               u.email,
               u.password,
               u.nickname,
               u.description,
               u.last_login_at,
               r.created_at,
               r.updated_at
        FROM user u
        JOIN root r ON u.id = r.id
            AND r.type = 'USER'
            AND <include refid="com.jslhrd.yorimichi.mapper.common.RootVisible"/>
        WHERE u.id = #{userId}
    </select>

    <!-- 요리 끝-->

    <select id="selectByEmail" parameterType="String" resultType="UserDTO">
        SELECT u.id,
               u.role_id,
               u.email,
               u.password,
               u.nickname,
               u.description,
               u.last_login_at,
               r.created_at,
               r.updated_at
        FROM user u
        JOIN root r ON u.id = r.id
            AND r.type = 'USER'
            AND <include refid="com.jslhrd.yorimichi.mapper.common.RootVisible"/>
        WHERE u.email = #{email}
    </select>

    <select id="existsNickname" parameterType="string" resultType="boolean">
        SELECT EXISTS (
            SELECT 1
            FROM user u
            JOIN root r ON u.id = r.id
                AND r.type = 'USER'
                AND <include refid="com.jslhrd.yorimichi.mapper.common.RootVisible"/>
            WHERE u.nickname = #{nickname}
        )
    </select>

    <select id="existsActive" parameterType="long" resultType="boolean">
        SELECT EXISTS (
            SELECT 1
            FROM user u
            JOIN root r ON u.id = r.id
                AND r.type = 'USER'
                AND <include refid="com.jslhrd.yorimichi.mapper.common.RootVisible"/>
            WHERE u.id = #{userId}
        )
    </select>

    <update id="update">
        UPDATE user u
        JOIN root r ON u.id = r.id
            AND r.type = 'USER'
            AND <include refid="com.jslhrd.yorimichi.mapper.common.RootVisible"/>
        SET u.nickname = #{user.nickname},
            u.description = #{user.description},
            u.gender = #{user.gender},
            u.year = #{user.year},
            u.show_reviews = #{user.showReviews},
            u.show_likes = #{user.showLikes},
            u.show_bookmarks = #{user.showBookmarks},
            u.show_following = #{user.showFollowees},
            u.show_followers = #{user.showFollowers},
            r.updated_at = NOW()
        WHERE u.id = #{userId}
    </update>

    <!-- @formatter:on -->

</mapper>
