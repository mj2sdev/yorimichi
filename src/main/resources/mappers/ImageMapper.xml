<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.jslhrd.yorimichi.mapper.ImageMapper">

    <!-- @formatter:off -->

    <select id="selectByReviewId" parameterType="long" resultType="ImageDTO">
        SELECT i.id, i.url, i.created_at, i.updated_at
        FROM image i
        JOIN root_image ri ON ri.image_id = i.id
        WHERE ri.root_id = #{reviewId}
        ORDER BY i.created_at
    </select>


    <select id="selectById" parameterType="long" resultType="ImageDTO">
        SELECT id,
               url,
               created_at,
               updated_at
        FROM image
        WHERE id = #{imageId}
    </select>

    <select id="existsById" parameterType="long" resultType="boolean">
        SELECT EXISTS (
            SELECT 1
            FROM image
            WHERE id = #{imageId}
        )
    </select>

    <insert id="insert"
            parameterType="ImageDTO"
            useGeneratedKeys="true"
            keyProperty="id"
            keyColumn="id">
        INSERT INTO image (url)
        VALUES (#{url})
    </insert>

    <update id="update">
        UPDATE image
        SET url = #{image.url}
        WHERE id = #{imageId}
    </update>

    <delete id="deleteById" parameterType="long">
        DELETE
        FROM image
        WHERE id = #{imageId}
    </delete>

    <!-- @formatter:on -->

</mapper>